# ==================== MySQL ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=starggle_main

# ==================== JWT（与 StarggleCom 共享） ====================
# 生产环境必须与 StarggleCom 使用同一个密钥，管理台登录 / 用户接口的 token 才能互通。
JWT_SECRET_KEY=change-me-to-the-same-secret-as-stargglecom

# 管理端白名单（逗号分隔的 user_id），必填。
# 留空时所有管理接口一律返回 403（fail-closed）。
# 登录使用共享 user_info 表的邮箱 + 密码，只有白名单内的账号能登录管理台。
ADMIN_USER_IDS=your-admin-user-id

# 管理角色（可选 JSON，键含 @ 按邮箱匹配，否则按 user_id 匹配）。
# 角色：admin / operator / developer / viewer；白名单内未配置的账号默认 admin。
# 修改后需重启服务生效；JSON 非法会导致服务启动失败。
# ADMIN_ROLES={"your-admin-user-id": "admin", "ops@example.com": "operator"}

# ==================== 业务开关 ====================
# 钻石计费：按 X-Generation-Id 聚合每次生成的实际成本，×3 后按 1 美元=50 钻石扣除。
# 会员日调用次数限额已下线，无需额外开关。

# 项目 Token：0=兼容旧调用；1=所有调用必须带 sk-gw- 项目 Token
# 无论开关如何，只要请求头带 sk-gw- 前缀都会校验。
GATEWAY_TOKEN_REQUIRED=0

# ==================== 服务 ====================
PORT=9010
GATEWAY_DEBUG=0

# 跨域管理台来源（逗号分隔）。页面与 API 同源时留空即可。
CORS_ORIGINS=https://www.starggle.com
